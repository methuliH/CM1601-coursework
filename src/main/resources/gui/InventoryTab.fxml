<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.InventoryTabController" visible="false">

    <!-- Topbar -->
    <HBox alignment="CENTER_LEFT" styleClass="topbar">
        <padding><Insets top="22" right="32" bottom="22" left="32"/></padding>
        <VBox spacing="2">
            <Label text="Inventory" styleClass="page-title"/>
            <Label text="Full stock list, grouped by category" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="inventoryAddPartBtn" text="+ Add Part" styleClass="primary-btn"/>
    </HBox>

    <!-- Body -->
    <VBox spacing="16" styleClass="tab-body" VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

        <!-- Stat cards -->
        <HBox spacing="14">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Items" styleClass="stat-label"/>
                <Label fx:id="inventoryTotalItemsLabel" text="Total Items: 0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Value" styleClass="stat-label"/>
                <Label fx:id="inventoryTotalValueLabel" text="Total Value: Rs 0.00" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <!-- Filter bar -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="panel-card">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <Label text="Keyword"/>
            <TextField fx:id="keywordField" prefWidth="160"/>

            <Label text="Category"/>
            <ComboBox fx:id="searchCategoryField" prefWidth="140"/>

            <Label text="Min Price"/>
            <TextField fx:id="minPriceField" prefWidth="90"/>

            <Label text="Max Price"/>
            <TextField fx:id="maxPriceField" prefWidth="90"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="runSearchBtn" text="Search" styleClass="primary-btn"/>
            <Button fx:id="clearSearchBtn" text="Clear" styleClass="danger-btn-outline"/>
        </HBox>

        <!-- Inventory table -->
        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codeColumn" text="Code" prefWidth="70"/>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
                <TableColumn fx:id="brandColumn" text="Brand" prefWidth="100"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="100"/>
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                <TableColumn fx:id="qtyColumn" text="Qty" prefWidth="60"/>
                <TableColumn fx:id="dateAddedColumn" text="Date Added" prefWidth="110"/>
                <TableColumn fx:id="thresholdColumn" text="Low-Stock At" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Actions -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="updateSelectedBtn" text="Update Selected" styleClass="primary-btn"/>
            <Button fx:id="deleteSelectedBtn" text="Delete Selected" styleClass="danger-btn-outline"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Low-stock threshold for selected:" styleClass="panel-list-secondary"/>
            <TextField fx:id="thresholdField" prefWidth="60"/>
            <Button fx:id="saveThresholdBtn" text="Save Threshold" styleClass="primary-btn"/>
        </HBox>
    </VBox>
</VBox>
